# Monerium: a PRIVATE application created in your own Monerium account
# (Developers -> Create application -> Private). Its token can see only that
# account's wallets, IBANs and orders, which is exactly what this tool needs.
MONERIUM_CLIENT_ID=
MONERIUM_CLIENT_SECRET=
# https://api.monerium.dev is the sandbox, https://api.monerium.app is real money.
MONERIUM_BASE_URL=https://api.monerium.app
# Optional: only mirror orders of this Monerium profile id.
MONERIUM_PROFILE=

# sevDesk: Settings -> Users -> your user -> API token (32 hex chars).
SEVDESK_API_TOKEN=
SEVDESK_BASE_URL=https://my.sevdesk.de/api/v1

# Where the order-id -> sevDesk-transaction map is kept. Losing it is safe:
# the next sync re-adopts existing rows by date, amount, IBAN and purpose.
SYNC_STATE_PATH=./state/sync.json

# On-chain EURe transfers are read from a JSON-RPC node per chain. Known
# chains have a public default (see src/chain.ts); override or add here.
# RPC_URL_GNOSIS=https://rpc.gnosischain.com
# RPC_URL_BASE=https://mainnet.base.org
# Blocks behind the head treated as final, and the largest eth_getLogs span
# asked for before halving on a refusal.
CHAIN_CONFIRMATIONS=12
CHAIN_MAX_BLOCK_SPAN=5000
